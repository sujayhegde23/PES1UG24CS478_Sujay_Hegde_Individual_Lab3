
@startuml
left to right direction
actor SysAdmin as SA
actor "Security Officer" as SO
actor "External Scheduler" as Timer
rectangle "Domain & SSL Certificate Expiry Alert System" {
  usecase "Manage Monitored Domains" as UC1
  usecase "Authenticate User" as UC2
  usecase "Perform Daily SSL/WHOIS Scan" as UC3
  usecase "Handle Expiry Alert" as UC4
  usecase "Acknowledge Expiry Alert" as UC5
  usecase "Escalate Unacknowledged Alert" as UC6
  usecase "Generate Monthly Report" as UC7
}
SA -- UC1
SA -- UC4
SA -- UC5
SA -- UC7
SO -- UC6
SO -- UC7
Timer -- UC3
Timer -- UC6
Timer -- UC7
UC1 ..> UC2 : <<include>>
UC5 ..> UC2 : <<include>>
UC4 ..> UC3 : <<extend>>\n[expiry threshold reached or expired]
UC6 ..> UC4 : <<extend>>\n[high-priority alert unacknowledged after 48h]
note bottom of UC4
  Generate notification and track the open alert.
  Acknowledgment closes the pending escalation.
end note
@enduml
